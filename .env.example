# ==========================================
# FasalAI Environment Configuration Template
# ==========================================
# Copy this file to .env and insert your real API keys:
# cp .env.example .env
#
# DO NOT commit your real .env file to Git!

# Groq Cloud API Key (LLaMA 3.1 inference for AI Chatbot)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Roboflow API Key (Computer vision model for pest & disease detection)
# Get a free key at: https://roboflow.com
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Hugging Face Access Token (Optional vision model fallback)
# Get a token at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Data.gov.in / Agmarknet API Key (Live Mandi prices & APMC commodity rates)
# Get a key at: https://data.gov.in
AGMARKNET_API_KEY=your_agmarknet_api_key_here

# Server Port
PORT=3000

# Environment Mode
NODE_ENV=production
