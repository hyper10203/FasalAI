{
  "name": "fasalai",
  "version": "1.0.0",
  "description": "FasalAI - Agricultural Intelligence Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path');const m=path.join(__dirname,'assets/models/convnext_tiny_plantdisease.onnx'),p=[0,1,2,3].map(i=>path.join(__dirname,'assets/models/convnext_tiny_plantdisease.onnx.part'+i));if(p.every(f=>fs.existsSync(f))&&(!fs.existsSync(m)||fs.statSync(m).size<1024*1024)){fs.writeFileSync(m,Buffer.concat(p.map(f=>fs.readFileSync(f))));console.log('Reassembled ONNX model in postinstall');}\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jimp": "^1.6.1",
    "onnxruntime-node": "^1.27.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Subham Paul Choudhury",
  "license": "ISC"
}
